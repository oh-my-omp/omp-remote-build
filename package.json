{
	"name": "omp-remote-build",
	"version": "0.2.0",
	"description": "omp plugin: per-worktree Mutagen replica to a remote Docker host with a Komodo-managed build/test container and container PTY tools.",
	"keywords": [
		"omp",
		"oh-my-pi",
		"mutagen",
		"komodo",
		"remote-build"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oh-my-omp/omp-remote-build.git"
	},
	"type": "module",
	"files": [
		"src",
		"!src/**/*.test.ts",
		"omomp-shared",
		"images",
		"examples",
		"README.md",
		"README.zh-CN.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"omomp": {
		"changelog": "CHANGELOG.md"
	},
	"peerDependencies": {
		"@oh-my-pi/omptype": "*",
		"@oh-my-pi/pi-agent-core": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-tui": "*",
		"@oh-my-pi/pi-utils": "*",
		"omp-actual-terminal": "*"
	},
	"peerDependenciesMeta": {
		"omp-actual-terminal": {
			"optional": true
		}
	},
	"scripts": {
		"check": "biome check . && tsc --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@oh-my-pi/omptype": "latest",
		"@oh-my-pi/pi-agent-core": "latest",
		"@oh-my-pi/pi-coding-agent": "latest",
		"@oh-my-pi/pi-tui": "latest",
		"@oh-my-pi/pi-utils": "latest",
		"@types/bun": "latest",
		"omp-actual-terminal": "github:oh-my-omp/omp-actual-terminal",
		"typescript": "latest"
	}
}
